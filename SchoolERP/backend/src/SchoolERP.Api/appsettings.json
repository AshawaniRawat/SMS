{
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "SchoolERP.Api",
    "Audience": "SchoolERP.Client",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "ClockSkewSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "uploads"
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": ""
  },
  "Identity": {
    "RequireConfirmedEmail": false,
    "PasswordRequiredLength": 8,
    "PasswordRequiredUniqueChars": 4,
    "MaxFailedAccessAttempts": 5,
    "DefaultLockoutMinutes": 15,
    "ActivateNewUsersImmediately": false,
    "AutoConfirmAdminCreatedUsers": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionStringName": "DefaultConnection",
    "ApplyMigrationsOnStartup": false,
    "SeedDevelopmentData": false,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 5,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  }
}
