{
  "OpenApi": { "Enabled": true, "EnableUi": true, "RoutePrefix": "swagger" },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=schoolerp;Username=postgres;Password=postgres"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Database": {
    "ConnectionStringName": "DefaultConnection",
    "ApplyMigrationsOnStartup": true,
    "SeedDevelopmentData": false,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 5,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "DevelopmentBootstrap": {
    "Enabled": false,
    "AdminEmail": "admin@gmail.com",
    "AdminPassword": "Admin@12345"
  },
  "Serilog":{"MinimumLevel":{"Default":"Information","Override":{"Microsoft":"Warning","Microsoft.AspNetCore":"Warning","Microsoft.EntityFrameworkCore.Database.Command":"Warning"}}},
  "LoggingFoundation":{"SlowRequestThresholdMs":2000,"EnableDevelopmentFileSink":false}
}
