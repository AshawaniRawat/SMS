{
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=schoolerp;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "SchoolERP.Api",
    "Audience": "SchoolERP.Client",
    "SigningKey": "SET_USING_ENVIRONMENT_OR_SECRET_STORE",
    "AccessTokenLifetimeMinutes": 15,
    "ClockSkewSeconds": 30
  },
  "Authentication": {
    "RefreshTokenLifetimeDays": 7,
    "RefreshTokenRetentionDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "uploads"
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionStringName": "DefaultConnection",
    "ApplyMigrationsOnStartup": false,
    "SeedDevelopmentData": false,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 5,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  }
}
